<?xml version="1.0" encoding="utf-8"?>
<!--
  Without this file the whole pipeline depends on machine-global NuGet state:
  the hooks push to a feed named "nuget-local" that only existed in one user's
  %AppData%\NuGet\NuGet.Config. On any other machine, restore of xyExtensions
  & co. simply fails. Now the local feed travels with the repo.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org"  value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="xy-local"   value="NuGets" />
  </packageSources>
  <packageSourceMapping>
    <!--
      "xy*" is wrong here: it also matches xyLogger and xyMessageFactory, which are
      real packages published on nuget.org, not local intra-family components. That
      makes them exclusively resolve from the local NuGets/ folder and NU1101 the
      moment a version isn't already sitting there or in the global cache — confirmed
      by a real `dotnet restore` (xyMessageFactory 1.0.1 exists on nuget.org, HTTP 200,
      but failed to restore under the wildcard mapping). List the actual local
      component ids explicitly instead.
    -->
    <packageSource key="xy-local">
      <package pattern="xyChrono" />
      <package pattern="xyEnumerables" />
      <package pattern="xyExtensions" />
      <package pattern="xyFilesystem" />
      <package pattern="xyFonts" />
      <package pattern="xyMaths" />
      <package pattern="xyPdf" />
      <package pattern="xyQOL" />
      <package pattern="xySecurity" />
      <package pattern="xySerialization" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
