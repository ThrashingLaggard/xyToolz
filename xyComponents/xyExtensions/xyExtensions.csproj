<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Standalone package project for the "Extensions" module.
    Source code stays in xyToolz/xyToolz/Extensions and is never copied or moved —
    this project just compiles it in place via a relative Compile Include.
    The push hook (.githooks/xy-sync-components.ps1) builds a merged snapshot
    of this csproj + that source folder and pushes it to the component repo.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>xyExtensions</PackageId>
    <PackageVersion>1.0.0</PackageVersion>
    <Authors>ThrashingLaggard</Authors>
    <NeutralLanguage>en-GB</NeutralLanguage>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <Copyright>Do with this, as you please. Go home to your dog   </Copyright>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\xyToolz\Extensions\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xyLogger" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
