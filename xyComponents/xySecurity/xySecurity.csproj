<Project Sdk="Microsoft.NET.Sdk">

  <!-- Source stays in xyToolz/xyToolz/Security, never copied/moved. See xyExtensions.csproj for the pattern. -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>xySecurity</PackageId>
    <PackageVersion>1.0.0</PackageVersion>
    <Authors>ThrashingLaggard</Authors>
    <NeutralLanguage>en-GB</NeutralLanguage>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <Copyright>Do with this, as you please. Go home to your dog   </Copyright>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\xyToolz\Security\**\*.cs" />
    <Compile Include="..\..\xyToolz\Interfaces\IxyDataProtector.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.IdentityModel.Tokens" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
    <PackageReference Include="xyLogger" />
    <ProjectReference Include="..\xyExtensions\xyExtensions.csproj" />
    <ProjectReference Include="..\xyQOL\xyQOL.csproj" />
    <ProjectReference Include="..\xyFilesystem\xyFilesystem.csproj" />
    <ProjectReference Include="..\xySerialization\xySerialization.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
