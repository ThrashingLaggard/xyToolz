<Project>
  <!--
    Shared metadata for every project in the tree. Previously each of the ten
    component csproj files repeated Authors / Copyright / License / NeutralLanguage
    verbatim, so a change meant ten edits and, in practice, drift.

    Version is deliberately NOT set here: the release hook injects it via -p:.
  -->
  <PropertyGroup>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <Authors>ThrashingLaggard</Authors>
    <Company>xy</Company>
    <NeutralLanguage>en-GB</NeutralLanguage>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <Copyright>Do with this, as you please. Go home to your dog</Copyright>
    <RepositoryType>git</RepositoryType>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Missing XML comments are warnings, not build breakers. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- Deterministic output in CI so the same source produces the same bytes. -->
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
